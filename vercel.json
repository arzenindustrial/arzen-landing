{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/assets/hero-1.jpg",
      "destination": "/assets/aerospace-fighter-jets-maintenance-hangar.jpg",
      "permanent": true
    },
    {
      "source": "/assets/hero-2.jpg",
      "destination": "/assets/commercial-aircraft-final-assembly-line.jpg",
      "permanent": true
    },
    {
      "source": "/assets/hero-3.jpg",
      "destination": "/assets/commercial-airliner-night-ramp-operations.jpg",
      "permanent": true
    },
    {
      "source": "/assets/hero-4.jpg",
      "destination": "/assets/navy-fighter-jets-formation-sunset.jpg",
      "permanent": true
    },
    {
      "source": "/assets/CNC_Machining.png",
      "destination": "/assets/cnc-milling-aluminum-part-sparks.jpg",
      "permanent": true
    },
    {
      "source": "/assets/Dimensional_Inspection.jpeg",
      "destination": "/assets/technician-inspecting-machined-parts.jpg",
      "permanent": true
    },
    {
      "source": "/assets/Tooling_Assembly.jpeg",
      "destination": "/assets/metalworker-grinding-fabrication-shop.jpg",
      "permanent": true
    },
    {
      "source": "/assets/Finished_Parts.jpeg",
      "destination": "/assets/metal-bar-stock-shelving-manufacturing-facility.jpg",
      "permanent": true
    }
  ]
}
