# Copie a .env.local. Valores públicos (NEXT_PUBLIC_*) llegan al navegador: nunca ponga secretos aquí.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# 1 = el dashboard usa datos de muestra (sin Supabase ni API). Útil para revisar la interfaz.
NEXT_PUBLIC_DEMO=0
NEXT_PUBLIC_SITE_URL=https://arzenindustrial.com
